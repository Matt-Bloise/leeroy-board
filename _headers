  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-FxN80pVgbTlbRq/Hn4p2zVWpiQ+tjIQ+PtbVBeJkZhk=' 'sha256-8S7wxnaCGT8ugLT4Wfj6nm96exEFITisKFDMIKJWkbo=' 'sha256-3Fpc/F1O6xKaU4gzvZYNmh5O/iE3Ffic4TY60K/QcDg='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' https://api.leeroy.party wss://api.leeroy.party https://*.joshbblaine.workers.dev wss://*.joshbblaine.workers.dev https://*.jmattbloise.workers.dev wss://*.jmattbloise.workers.dev; frame-ancestors 'self' https://discord.com https://*.discordsays.com; object-src 'none'; base-uri 'none'

# Content-Security-Policy-Report-Only, not enforced yet. Measured with every page and scene: normal pages produce no violation report with this policy (inline styles are allowed because the board sets style attributes and has <style> blocks; the three inline scripts in index.html are allowed by hash; images may be data: for the inline crest medallions; the PR preview Workers are allowed in connect-src). Not yet proven against the Discord Activity, so it stays report-only. tests/unit/csp-headers.test.mjs keeps every inline-script hash in step with index.html.
# Cache-Control. Non-overlapping path rules only: Pages joins the headers of every matching rule, so /* must never carry one.
# HTML (/ and /index.html) gets no rule here and keeps the Pages default, max-age=0, must-revalidate, so new ?v= stamps are seen at once.
# js, scenes, css, vendor, cloth, next, room: immutable for a year. Every reference carries ?v=<sha256 first 10 hex of the file> and CI (tools/stamps.mjs --check) fails on a stale stamp, so a changed file is a new URL.
# /atlas: only the 10 atlas js files and panels.css are immutable, listed one by one (every reference to them carries ?v=, enforced by stamps --check).
# Tiles (/atlas/tiles/*) and plates (/atlas/plates/*) are binary and get the short /img-style cache; tiles/index.json is fetched no-store by atlas.js. These rules do not overlap the file rules.

/fonts/*
  Cache-Control: public, max-age=2592000

/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/js/*
  Cache-Control: public, max-age=31536000, immutable

/scenes/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/cloth/*
