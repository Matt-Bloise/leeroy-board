/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy-Report-Only: default-src 'self' https://api.leeroy.party https://*.discordsays.com https://static.cloudflareinsights.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://api.leeroy.party https://*.workers.dev https://*.discordsays.com https://cloudflareinsights.com

# Content-Security-Policy-Report-Only is NOT enforced (nothing is blocked); promote it to Content-Security-Policy only after the console shows no violations.
# TODO when enforcing: add `frame-ancestors https://discord.com https://*.discordsays.com` (browsers ignore it, and WebKit logs a console error, in a report-only policy), and drop https://*.workers.dev from connect-src (it is only there for the per-PR preview Workers).
# Cache-Control. Non-overlapping path rules only: Pages joins the headers of every matching rule, so /* must never carry one.
# HTML (/ and /index.html) gets no rule here and keeps the Pages default, max-age=0, must-revalidate, so new ?v= stamps are seen at once.
# js, scenes, css, vendor, cloth, next, room: immutable for a year. Every reference carries ?v=<sha256 first 10 hex of the file> and CI (tools/stamps.mjs --check) fails on a stale stamp, so a changed file is a new URL.
# /atlas: only the 10 atlas js files and panels.css are immutable, listed one by one (every reference to them carries ?v=, enforced by stamps --check).
# Tiles (/atlas/tiles/*) and plates (/atlas/plates/*) are binary and get the short /img-style cache; tiles/index.json is fetched no-store by atlas.js. These rules do not overlap the file rules.

/fonts/*
  Cache-Control: public, max-age=2592000

/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/js/*
  Cache-Control: public, max-age=31536000, immutable

/scenes/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/cloth/*
  Cache-Control: public, max-age=31536000, immutable

/next/*
  Cache-Control: public, max-age=31536000, immutable

/room/*
  Cache-Control: public, max-age=31536000, immutable

/atlas/tiles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/atlas/plates/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/atlas/atlas.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/cards.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/foley.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/geo.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/gestures.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/layers.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/routes.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/shape.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/tokens.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/view.js
  Cache-Control: public, max-age=31536000, immutable

/atlas/panels.css
  Cache-Control: public, max-age=31536000, immutable
