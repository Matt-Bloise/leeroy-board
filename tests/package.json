{
  "name": "leeroy-board-tests",
  "private": true,
  "type": "module",
  "description": "API and browser tests run against a PR preview environment. No AI keys, no secrets in this file.",
  "scripts": {
    "test:api": "node --test --test-concurrency=1 --test-reporter=spec api/api.test.mjs api/contract.test.mjs",
    "test:crawl": "node --test --test-concurrency=1 --test-reporter=spec api/preview-crawl.test.mjs",
    "test:recover": "node api/recover-preview.mjs",
    "test:browser": "node browser/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "1.49.1",
    "yaml": "^2.6.1"
  }
}
